{
  "name": "ytviddownloader",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run server\" \"next start -p ${PORT:-3000}\"",
    "start:next": "next start",
    "lint": "eslint",
    "server": "tsx server/index.ts",
    "start:backend": "IS_STANDALONE_BACKEND=true tsx server/index.ts",
    "dev:all": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run server\" \"npm run dev\"",
    "start:all": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run server\" \"next start -p ${PORT:-3000}\"",
    "postinstall": "node scripts/ensure-ytdlp.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
